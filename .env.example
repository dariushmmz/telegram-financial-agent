# Copy to a secure environment source; never commit populated credentials.
RECEIPT_BOT_DATABASE_URL=sqlite:///data/receipt_bot.db
RECEIPT_BOT_DATA_ROOT=./data
RECEIPT_BOT_LOG_LEVEL=INFO
RECEIPT_BOT_RETENTION_DAYS=183
RECEIPT_BOT_TIMEZONE=Asia/Tehran
RECEIPT_BOT_SENSITIVE_DEBUG=false
RECEIPT_BOT_EXTRACTION_PROVIDER=gemini
RECEIPT_BOT_GEMINI_MODELS=gemini-3.8-flash
# Required only when RECEIPT_BOT_EXTRACTION_PROVIDER=openrouter.
RECEIPT_BOT_OPENROUTER_MODEL=google/gemini-3.8-flash
RECEIPT_BOT_TELEGRAM_BOT_USERNAME=
RECEIPT_BOT_TELEGRAM_POLL_TIMEOUT_SECONDS=30
RECEIPT_BOT_INTERACTION_TTL_MINUTES=15
RECEIPT_BOT_SHUTDOWN_GRACE_SECONDS=30
RECEIPT_BOT_PROVIDER_REQUEST_TIMEOUT_SECONDS=45
RECEIPT_BOT_RECEIPT_MAX_DOWNLOAD_ATTEMPTS=3
RECEIPT_BOT_RECEIPT_MAX_EXTRACTION_ATTEMPTS=5
RECEIPT_BOT_RECEIPT_RETRY_BASE_SECONDS=30
RECEIPT_BOT_RECEIPT_RETRY_MAX_SECONDS=900
RECEIPT_BOT_RECEIPT_RETRY_JITTER_RATIO=0.20
RECEIPT_BOT_RECEIPT_PROVIDER_COOLDOWN_SECONDS=60
RECEIPT_BOT_RECEIPT_DELAY_NOTIFICATION_SECONDS=300
# Required: comma-separated Telegram usernames allowed to authorize groups.
# Leading @ is optional; matching is case-insensitive. Example: @amixrmz,backup_admin
RECEIPT_BOT_ALLOWED_TELEGRAM_USERNAMES=

# Provider credentials are optional until that provider is selected.
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
